# SECONDORDER Production Environment Configuration Template

# ==================================================
# BACKEND CONFIGURATION
# ==================================================

# Optional: Groq LLM API key for AI deployment reasoning
GROQ_API_KEY=your_groq_api_key_here

# Allowed CORS origins (comma-separated, or * for public)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Bind Settings
HOST=0.0.0.0
PORT=8000

# ==================================================
# FRONTEND CONFIGURATION (Built into Vite bundle)
# ==================================================

# API Base URL used by React frontend (leave empty for same-origin proxy)
VITE_API_BASE_URL=http://127.0.0.1:8000
